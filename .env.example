# ==== Core Service Environment Variables ====
# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=4000
# Bind address for the dashboard-facing API. Keep this as 127.0.0.1 unless you
# deliberately want to expose the dashboard to your local network (Section 4b).
HOST=127.0.0.1

# --- Dashboard auth ---
# Static token the frontend must send as "X-Auth-Token" on every request.
DASHBOARD_AUTH_TOKEN=change_me_to_a_long_random_string

# --- Database ---
DATABASE_FILE=./data/core.db

# --- Encryption ---
# 32-byte (64 hex char) key used for AES-256-GCM encryption of stored supplier secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Supplier selection (Phase 2) ---
# Global switch mode. Per-item override happens via the variants.supplier_type column.
ACTIVE_SUPPLIER=CJ

# --- CJ Dropshipping credentials (Phase 2) ---
CJ_API_KEY=
CJ_API_SECRET=

# --- CSV / Manual Supplier credentials (optional) ---
# Used when ACTIVE_SUPPLIER=CSV or when any variant has supplier_type=CSV.
# CSV_SUPPLIER_WEBHOOK_URL: POST target for order dispatch. Leave blank for
#   manual mode (orders written to logs/manual-orders.jsonl instead).
# CSV_SUPPLIER_API_KEY: Bearer token sent on webhook calls (optional).
CSV_SUPPLIER_WEBHOOK_URL=
CSV_SUPPLIER_API_KEY=

# --- eBay credentials (Phase 3) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# "sandbox" while testing, "production" once you're ready to go live.
EBAY_ENVIRONMENT=sandbox
VERO_BLOCKLIST_PATH=./config/vero-blocklist.txt

# --- Scout Service pull (Phase 8) ---
SCOUT_SERVICE_URL=http://127.0.0.1:4100
SCOUT_PULL_TIMEOUT_MS=8000

# --- Alerts on repeated job failure (Phase 9) ---
# Fires when a sync/order-routing/fulfillment job fails this many times in a
# row. Both are optional — set either, both, or neither.
ALERT_FAILURE_THRESHOLD=3
# Slack-compatible incoming webhook URL (Slack, Discord's Slack-compatible
# endpoint, Mattermost, etc.) — posts {"text": "..."}.
ALERT_WEBHOOK_URL=
# Telegram alternative: create a bot via @BotFather, then message it once
# and visit https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Pricing formula config (Section 4) ---
PROFIT_MARGIN_PERCENT=0.30
EBAY_FEE_ESTIMATE=2.50

# --- Guardrails (Section 5) ---
AUTO_ORDER_ENABLED=false
SAFETY_STOCK_BUFFER=5
SYNC_INTERVAL_MINUTES=15

# --- Logging ---
LOG_FILE=./logs/core.log
