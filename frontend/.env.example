# URL of the Core Service backend API — used for LOCAL DEVELOPMENT only,
# where the frontend runs on its own dev server (port 5173) separate from
# the backend (port 4000).
#
# In PRODUCTION (e.g. Railway), this file should NOT be created / this
# variable should be left unset — the backend serves this built frontend
# itself from the same origin, so requests should be relative (leaving this
# blank makes that happen automatically).
VITE_API_BASE=http://127.0.0.1:4000
