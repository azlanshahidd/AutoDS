# ==== Core Service — STAGING environment ====
# Copy this to .env on your staging Railway service (or local Docker stack).
# CRITICAL DIFFERENCES vs production:
#   AUTO_ORDER_ENABLED=false  — never place real orders from staging
#   EBAY_ENVIRONMENT=sandbox  — use eBay sandbox, never production API
#   DATABASE_FILE points at a copy of the DB, never the production file

PORT=4000
HOST=0.0.0.0

# Use a different token from production so a leaked staging token can't
# authenticate to the production dashboard.
DASHBOARD_AUTH_TOKEN=CHANGE_ME_staging_long_random_string

# Use a different encryption key from production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_generate_a_64_char_hex_string_for_staging

# SQLite database — in Railway, mount a SEPARATE volume from production.
DATABASE_FILE=./data/core-staging.db

# ── SAFETY SWITCHES — do not change these on staging ─────────────────────────
# Orders are logged but NEVER placed on staging.
AUTO_ORDER_ENABLED=false
# Use eBay sandbox API — never the production API.
EBAY_ENVIRONMENT=sandbox

# ── eBay sandbox credentials (from developer.ebay.com sandbox app) ────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
VERO_BLOCKLIST_PATH=./config/vero-blocklist.txt

# ── Supplier — use TEST plugin on staging, never CJ production API ────────────
ACTIVE_SUPPLIER=TEST
CJ_API_KEY=
CJ_API_SECRET=

# ── Pricing ───────────────────────────────────────────────────────────────────
PROFIT_MARGIN_PERCENT=0.30
EBAY_FEE_ESTIMATE=2.50

# ── Guardrails ────────────────────────────────────────────────────────────────
SAFETY_STOCK_BUFFER=5
SYNC_INTERVAL_MINUTES=15

# ── Scout ─────────────────────────────────────────────────────────────────────
SCOUT_SERVICE_URL=http://127.0.0.1:4100
SCOUT_PULL_TIMEOUT_MS=8000

# ── Alerts — point at a test Slack/Telegram channel, not production ───────────
ALERT_FAILURE_THRESHOLD=3
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=./logs/core-staging.log
